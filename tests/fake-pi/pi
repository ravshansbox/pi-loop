#!/usr/bin/env bash
set -euo pipefail

count=$(($(cat "$FAKE_PI_DIR/calls" 2>/dev/null || echo 0) + 1))
echo "$count" >"$FAKE_PI_DIR/calls"
printf '%s\n' "$@" >"$FAKE_PI_DIR/args-$count"

if [[ -f "$FAKE_PI_DIR/context-$count" ]]; then
  cp "$FAKE_PI_DIR/context-$count" context.md
fi

if [[ -f "$FAKE_PI_DIR/done-$count" ]]; then
  echo done >status.txt
fi

if [[ -f "$FAKE_PI_DIR/sleep-$count" ]]; then
  sleep "$(cat "$FAKE_PI_DIR/sleep-$count")"
fi

cat "$FAKE_PI_DIR/round.jsonl"
